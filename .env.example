# Copiar para .env (nunca fazer commit). Sem DATABASE_URL usa PGlite local em ./data.
PORT=3000
BASE_URL=http://localhost:3000
BRAND_NAME=Conversations
SUPPORT_EMAIL=support@example.com
APP_SECRET=
ALLOW_SIGNUP=false
DATABASE_URL=
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# S3_BUCKET= S3_REGION= S3_ENDPOINT= S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY=
MAILERSEND_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Conversations
OPENAI_API_KEY=
# AI_MOCK=1 gera tudo em modo simulado (sem rede), só para testes/demonstração
AI_MOCK=
OPENAI_MODEL_TRANSCRIBE=gpt-4o-transcribe
OPENAI_MODEL_TIMESTAMPS=whisper-1
OPENAI_MODEL_TEXT=gpt-4.1
OPENAI_MODEL_SPEECH=gpt-4o-mini-tts
OPENAI_MODEL_IMAGE=gpt-image-1
OPENAI_VOICE_HOST=coral
OPENAI_VOICE_GUEST=onyx
